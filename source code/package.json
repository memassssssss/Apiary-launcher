{
  "name": "apiary-launcher",
  "version": "1.5.0",
  "description": "Apiary Minecraft Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-store": "^6.0.1",
    "minecraft-launcher-core": "^3.12.0",
    "msmc": "^5.0.5",
    "tar": "^6.2.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.apiary.launcher",
    "productName": "Apiary Launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apiary Launcher"
    }
  }
}
